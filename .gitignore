# Dependencies
node_modules/

# Environment variables — never commit secrets
.env
.env.local
.env.*.local

# Build output
dist/
dist-ssr/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local-only uploads (disk-storage fallback when Cloudinary isn't configured)
backend/uploads/*
!backend/uploads/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json
